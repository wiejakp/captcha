{
    "name": "wiejakp/captcha",
    "description": "Captcha library for PHP applications.",
    "type": "library",
    "keywords": ["php", "library", "captcha"],
    "homepage": "https://github.com/wiejakp/captcha",
    "license": "MIT",
    "authors": [
        {
            "name": "Przemek Wiejak",
            "email": "przemek@wiejak.app",
            "homepage": "https://www.wiejak.app"
        }
    ],
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "support": {
        "docs": "https://wiejakp.github.io/captcha/",
        "issues": "https://github.com/wiejakp/captcha/issues",
        "rss": "https://github.com/wiejakp/captcha/releases.atom",
        "source": "https://github.com/wiejakp/captcha.git",
        "wiki": "https://github.com/wiejakp/captcha/wiki"
    },
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "symfony/http-foundation": "^6.4",
        "symfony/security-core": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-pcov": "Provides code coverage for PHPUnit 10 when Xdebug is unavailable."
    },
    "autoload": {
        "psr-4": {
            "wiejakp\\captcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "wiejakp\\captcha\\Tests\\": "test/phpunit/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --do-not-cache-result",
        "test:coverage": "@php vendor/bin/phpunit --do-not-cache-result --coverage-text"
    }
}
